{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apigames",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // 本番の console.* をダッシュボードで見られるようにする（Free プランでも可）
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  // IP ごとのレート制限（src/lib/ratelimit.ts）。カウンタは拠点ごとの概算。period は 10 か 60 だけ。
  // namespace_id はアカウント内で一意の整数（文字列）。period を変えたら src/index.ts の Retry-After も合わせる
  "ratelimits": [
    // POST /users
    { "name": "RL_USERS", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // POST /rooms・/quickmatch・/rooms/:id/join・/rooms/:id/rematch（DO を起こす書き込み）
    { "name": "RL_ROOMS", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    // GET /rooms/:id/ws（接続1本 = DO の1リクエスト。再接続のバックオフなら届かない程度）
    { "name": "RL_WS", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    // DO・D1 を読むその他のルート（/rooms/:id/state・/log・/replay・/action・/resign・/start・/leave、GET /rooms・/matches・/users/:id）。
    // /state のポーリング止め（2秒おきなら通る）
    { "name": "RL_READS", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      // `pnpm wrangler d1 create apigames` で作成した ID
      "database_name": "apigames",
      "database_id": "c726ff90-174f-4c35-844e-b2d58a376b90",
      "migrations_dir": "migrations"
    }
  ]
}
